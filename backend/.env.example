# Copy to .env (or set these in your hosting dashboard)
PORT=8080
# REQUIRED in production: long random string
JWT_SECRET=change-me-to-a-long-random-string
# First admin account, created automatically on first start
ADMIN_EMAIL=admin@jobportal.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Super Admin
# Where the SQLite DB and uploaded resumes live. On Render/Railway point this at a persistent disk.
DATA_DIR=./data
# Only needed if frontend is hosted on a different domain (e.g. Vercel). Comma separated.
CORS_ORIGIN=
